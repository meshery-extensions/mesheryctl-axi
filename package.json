{
  "name": "mesheryctl-axi",
  "version": "0.3.1",
  "description": "AXI-compliant mesheryctl wrapper - token-efficient TOON output for agent workflows",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meshery-extensions/mesheryctl-axi.git"
  },
  "author": "Meshery Authors",
  "keywords": [
    "meshery",
    "mesheryctl",
    "cli",
    "agent",
    "axi",
    "toon"
  ],
  "bin": {
    "mesheryctl-axi": "dist/bin/mesheryctl-axi.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx bin/mesheryctl-axi.ts",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "format:write": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@toon-format/toon": "^4.1.1",
    "axi-sdk-js": "^0.1.11",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsx": "^4.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "homepage": "https://github.com/meshery-extensions/mesheryctl-axi#readme",
  "bugs": {
    "url": "https://github.com/meshery-extensions/mesheryctl-axi/issues"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
